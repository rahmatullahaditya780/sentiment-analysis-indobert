# ── Template secrets Streamlit Community Cloud ────────────────────────────────
# Salin isi file ini ke menu "Secrets" aplikasi di Streamlit Community Cloud
# (Manage app -> Settings -> Secrets). JANGAN commit secrets.toml asli — sudah
# di-gitignore. Streamlit Cloud meng-inject tiap key di sini sebagai environment
# variable, sehingga terbaca os.getenv() oleh kode Sentara.

# Repo HuggingFace Hub berisi bobot IndoBERT fine-tuned (Fase 4).
# Wajib di cloud karena models/best_model/ tidak ikut repo (ukuran ~500MB).
MODEL_HUB_ID = "username/sentara-indobert"

# Level logging (DEBUG | INFO | WARNING | ERROR). Default INFO bila kosong.
LOG_LEVEL = "INFO"

# (Opsional) Paksa mode lingkungan. Di cloud, deteksi otomatis sudah benar;
# isi "cloud" hanya bila ingin memaksa menonaktifkan tab URL Auto-Fetch.
# SENTARA_FORCE_ENV = "cloud"
