# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=sentara
STREAMLIT_SERVER_PORT=8501

# ── Model ─────────────────────────────────────────────────────────────────────
MODEL_NAME=indolem/indobert-base-uncased
MODEL_MAX_LENGTH=128
# Repo HuggingFace Hub berisi bobot IndoBERT fine-tuned (Fase 4). Dipakai sebagai
# sumber model saat folder lokal models/best_model/ tidak ada (deploy cloud).
# Kosongkan untuk menjalankan murni dari model lokal.
MODEL_HUB_ID=

# ── Logging & Lingkungan (Fase 10) ────────────────────────────────────────────
# Level logging: DEBUG | INFO | WARNING | ERROR (default INFO).
LOG_LEVEL=INFO
# Paksa deteksi lingkungan: cloud | local. Kosongkan untuk deteksi otomatis
# (cloud menonaktifkan tab URL Auto-Fetch — lihat FR-8.14).
SENTARA_FORCE_ENV=

# ── Shopee Open Platform API (OAuth2) ─────────────────────────────────────────
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_REDIRECT_URL=http://localhost:8501
